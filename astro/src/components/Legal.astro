---
/** Mentions légales (FR) / Legal notice (EN) : textes à compléter. */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../lib/content';
import { t as dictionary } from '../i18n';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = dictionary(lang);
const paths = { fr: '/mentions-legales/', en: '/en/legal-notice/' };
const altHref = lang === 'fr' ? paths.en : paths.fr;
const fr = lang === 'fr';
---
<Base lang={lang} title={`${t.ui.legalTitle} — Peleweb`} description={t.meta.description} locale={t.meta.locale} paths={paths}>
  <Header t={t} lang={lang} altHref={altHref} />
  <main id="contenu" class="wrap legal">
    <h1>{t.ui.legalTitle}</h1>
    {fr ? (
      <>
        <h2>Éditeur du site</h2>
        <p>Umberto Persichini — [statut juridique, ex. micro-entrepreneur]<br>SIRET : [numéro]<br>Adresse : [adresse]<br>Email : <a href="mailto:contact@peleweb.com">contact@peleweb.com</a></p>
        <h2>Hébergement</h2>
        <p>Netlify, Inc. — 512 2nd Street, Suite 200, San Francisco, CA 94107, États-Unis — netlify.com</p>
        <h2>Données personnelles</h2>
        <p>[Texte à compléter : données collectées, finalités, durée de conservation, vos droits.]</p>
      </>
    ) : (
      <>
        <h2>Publisher</h2>
        <p>Umberto Persichini — [legal status]<br>Company number: [SIRET]<br>Address: [address]<br>Email: <a href="mailto:contact@peleweb.com">contact@peleweb.com</a></p>
        <h2>Hosting</h2>
        <p>Netlify, Inc. — 512 2nd Street, Suite 200, San Francisco, CA 94107, USA — netlify.com</p>
        <h2>Personal data</h2>
        <p>[To be completed: data collected, purposes, retention period, your rights.]</p>
      </>
    )}
  </main>
  <Footer t={t} lang={lang} altHref={altHref} />
</Base>
