---
/**
 * Pages légales, en français, anglais et espagnol :
 *  - page="legal"   : mentions légales / legal notice / aviso legal
 *  - page="privacy" : politique de confidentialité / privacy policy / política de privacidad
 *
 * Les textes sont dans l'objet `content` ci-dessous.
 */
import Base from '../layouts/Base.astro';
import Header from './Header.astro';
import Footer from './Footer.astro';
import type { Lang } from '../lib/content';
import { t as dictionary } from '../i18n';

interface Props { lang: Lang; page: 'legal' | 'privacy' }
const { lang, page } = Astro.props;
const t = dictionary(lang);

const SIRET = '894 636 505 00014';
const UPDATED = { fr: '13 novembre 2026', en: '13 November 2026', es: '13 de noviembre de 2026' };
const mail = '<a href="mailto:contact@peleweb.com">contact@peleweb.com</a>';
const address = '7 rue de l’Amazone, 95490 Vauréal, France';
const netlify = 'Netlify, Inc. — 101 2nd Street, San Francisco, CA 94105, USA — <a href="https://www.netlify.com" rel="noopener">netlify.com</a>';

const allPaths = {
  legal: { fr: '/mentions-legales/', en: '/en/legal-notice/', es: '/es/aviso-legal/' },
  privacy: { fr: '/politique-de-confidentialite/', en: '/en/privacy-policy/', es: '/es/politica-de-privacidad/' },
};
const paths = allPaths[page];

type Section = { h: string; p: string };
const content: Record<'legal' | 'privacy', Record<Lang, Section[]>> = {
  legal: {
    fr: [
      { h: 'Éditeur du site', p: `Le site peleweb.com est édité par <strong>Umberto Persichini</strong>, entrepreneur individuel (auto-entreprise) exerçant sous le nom commercial <strong>Peleweb</strong>.<br>Adresse : ${address}<br>SIRET : ${SIRET}<br>Email : ${mail}` },
      { h: 'Directeur de la publication', p: 'Umberto Persichini.' },
      { h: 'Hébergement', p: `Le site est hébergé par ${netlify}.` },
      { h: 'Propriété intellectuelle', p: 'L’ensemble des contenus de ce site (textes, illustrations, graphismes, code) est la propriété de Peleweb, sauf mention contraire. Toute reproduction, totale ou partielle, sans autorisation écrite préalable est interdite.<br>Les logos, noms et captures d’écran des sites clients sont la propriété de leurs titulaires respectifs et sont présentés à titre de références.' },
      { h: 'Liens externes', p: 'Le site contient des liens vers des sites tiers (réalisations, profils). Peleweb n’exerce aucun contrôle sur ces sites et décline toute responsabilité quant à leur contenu.' },
      { h: 'Données personnelles et cookies', p: `Le traitement de vos données est détaillé dans la <a href="${allPaths.privacy.fr}">politique de confidentialité</a>. Le site utilise Google Analytics pour mesurer son audience, uniquement si vous l’acceptez. Vous pouvez modifier votre choix à tout moment via le lien « Gérer les cookies » en bas de page.` },
    ],
    en: [
      { h: 'Publisher', p: `peleweb.com is published by <strong>Umberto Persichini</strong>, sole trader (French auto-entreprise) trading as <strong>Peleweb</strong>.<br>Address: ${address}<br>Company number (SIRET): ${SIRET}<br>Email: ${mail}` },
      { h: 'Publication director', p: 'Umberto Persichini.' },
      { h: 'Hosting', p: `The website is hosted by ${netlify}.` },
      { h: 'Intellectual property', p: 'All content on this website (text, illustrations, graphics, code) belongs to Peleweb unless stated otherwise. Any full or partial reproduction without prior written permission is prohibited.<br>Client logos, names and website screenshots belong to their respective owners and are shown as references.' },
      { h: 'External links', p: 'This website links to third-party websites (projects, profiles). Peleweb has no control over them and accepts no liability for their content.' },
      { h: 'Personal data and cookies', p: `How your data is handled is described in the <a href="${allPaths.privacy.en}">privacy policy</a>. This website uses Google Analytics to measure its audience, only if you accept it. You can change your choice at any time with the “Manage cookies” link at the bottom of the page.` },
    ],
    es: [
      { h: 'Responsable del sitio', p: `El sitio peleweb.com lo edita <strong>Umberto Persichini</strong>, empresario individual (auto-entreprise francesa) con el nombre comercial <strong>Peleweb</strong>.<br>Dirección: ${address}<br>Número de empresa (SIRET): ${SIRET}<br>Email: ${mail}` },
      { h: 'Director de la publicación', p: 'Umberto Persichini.' },
      { h: 'Alojamiento', p: `El sitio está alojado por ${netlify}.` },
      { h: 'Propiedad intelectual', p: 'Todos los contenidos de este sitio (textos, ilustraciones, gráficos, código) pertenecen a Peleweb, salvo indicación contraria. Queda prohibida su reproducción total o parcial sin autorización previa por escrito.<br>Los logotipos, nombres y capturas de los sitios de clientes pertenecen a sus respectivos titulares y se muestran como referencias.' },
      { h: 'Enlaces externos', p: 'El sitio contiene enlaces a sitios de terceros (proyectos, perfiles). Peleweb no tiene control sobre ellos y declina toda responsabilidad sobre su contenido.' },
      { h: 'Datos personales y cookies', p: `El tratamiento de sus datos se detalla en la <a href="${allPaths.privacy.es}">política de privacidad</a>. El sitio utiliza Google Analytics para medir su audiencia, solo si usted lo acepta. Puede cambiar su elección en cualquier momento con el enlace «Gestionar cookies» al pie de página.` },
    ],
  },
  privacy: {
    fr: [
      { h: 'Responsable du traitement', p: `Umberto Persichini (Peleweb, auto-entreprise), ${address}. Contact : ${mail}` },
      { h: 'Données collectées', p: 'Le site ne comporte ni formulaire ni compte utilisateur. Les données traitées sont :<br>• <strong>les messages que vous envoyez par email ou par WhatsApp</strong> (nom, numéro de téléphone pour WhatsApp, adresse email, contenu du message, et toute information que vous choisissez de partager) ;<br>• <strong>les données techniques de connexion</strong> (adresse IP, type de navigateur, pages demandées), enregistrées automatiquement par l’hébergeur pour afficher le site et le protéger ;<br>• <strong>les statistiques de visite</strong>, <em>uniquement si vous les acceptez</em> : pages consultées, durée de visite, provenance (moteur de recherche, lien…), type d’appareil et de navigateur, ville ou pays approximatif. Ces données sont collectées par Google Analytics à l’aide de cookies.' },
      { h: 'Finalités et bases légales', p: '• Répondre à vos demandes et établir un devis : mesures précontractuelles prises à votre demande (art. 6.1.b du RGPD).<br>• Assurer le fonctionnement et la sécurité du site : intérêt légitime (art. 6.1.f du RGPD).<br>• Mesurer l’audience du site pour l’améliorer : votre consentement (art. 6.1.a du RGPD), que vous pouvez retirer à tout moment.<br>• Si vous devenez client : exécution du contrat et obligations comptables (art. 6.1.b et 6.1.c du RGPD).' },
      { h: 'Durées de conservation', p: '• Échanges avec un prospect : 3 ans à compter du dernier contact.<br>• Documents liés à un contrat et pièces comptables : 10 ans, conformément au Code de commerce.<br>• Statistiques Google Analytics : 14 mois ; les cookies de mesure expirent au plus tard après 13 mois.<br>• Votre choix concernant les cookies : 6 mois, après quoi il vous est demandé à nouveau.<br>• Journaux techniques de l’hébergeur : selon la politique de Netlify, pour une durée limitée.' },
      { h: 'Destinataires et transferts', p: `Vos données sont destinées uniquement à Peleweb et ne sont jamais vendues ni cédées. Elles peuvent être traitées par les prestataires suivants :<br>• l’hébergeur du site, ${netlify} ;<br>• Google Ireland Limited (Gordon House, Barrow Street, Dublin 4, Irlande), pour la mesure d’audience Google Analytics, si vous l’avez acceptée ;<br>• le fournisseur de messagerie de contact@peleweb.com (OVHcloud, France) ;<br>• WhatsApp Ireland Limited, si vous me contactez via le bouton WhatsApp (le lien ouvre l’application WhatsApp, soumise à sa propre politique de confidentialité).<br>Netlify, Google LLC et Meta Platforms (maison mère de WhatsApp) sont situés aux États-Unis : ces transferts sont encadrés par le Data Privacy Framework UE–États-Unis, auquel ces sociétés adhèrent.` },
      { h: 'Cookies et traceurs', p: 'Lors de votre première visite, un bandeau vous permet d’<strong>accepter ou de refuser</strong> la mesure d’audience, aussi simplement l’un que l’autre. Sans accord de votre part, aucun cookie Google Analytics n’est déposé et aucune donnée n’est envoyée à Google.<br>Les traceurs utilisés sont :<br>• <strong>_ga</strong> et <strong>_ga_&lt;identifiant&gt;</strong> (Google Analytics, 13 mois maximum) : distinguer les visiteurs et les visites, uniquement après votre accord ;<br>• <strong>pw-consent</strong> (stockage local, 6 mois) : mémoriser votre choix concernant les cookies ;<br>• <strong>pw-theme</strong> (stockage local) : mémoriser votre choix de thème clair ou sombre.<br>Les polices de caractères sont hébergées sur le site lui-même : elles n’entraînent aucun échange avec un tiers.<br>Vous pouvez modifier votre choix à tout moment avec le lien <strong>« Gérer les cookies »</strong> en bas de chaque page, ou supprimer les cookies depuis les réglages de votre navigateur.' },
      { h: 'Vos droits', p: `Vous disposez d’un droit d’accès, de rectification, d’effacement, de limitation, d’opposition et de portabilité de vos données, ainsi que du droit de retirer votre consentement à tout moment. Pour les exercer, écrivez à ${mail}. Une réponse vous est apportée dans un délai d’un mois.<br>Si vous estimez que vos droits ne sont pas respectés, vous pouvez adresser une réclamation à la CNIL : <a href="https://www.cnil.fr" rel="noopener">cnil.fr</a>.` },
    ],
    en: [
      { h: 'Data controller', p: `Umberto Persichini (Peleweb, French auto-entreprise), ${address}. Contact: ${mail}` },
      { h: 'Data collected', p: 'This website has no forms and no user accounts. The data processed is:<br>• <strong>messages you send by email or WhatsApp</strong> (name, phone number for WhatsApp, email address, message content and any information you choose to share);<br>• <strong>technical connection data</strong> (IP address, browser type, requested pages), logged automatically by the host to serve and protect the website;<br>• <strong>visit statistics</strong>, <em>only if you accept them</em>: pages viewed, visit duration, traffic source (search engine, link…), device and browser type, approximate city or country. This data is collected by Google Analytics using cookies.' },
      { h: 'Purposes and legal bases', p: '• Answering your requests and preparing a quote: pre-contractual steps taken at your request (Art. 6(1)(b) GDPR).<br>• Running and securing the website: legitimate interest (Art. 6(1)(f) GDPR).<br>• Measuring the website’s audience to improve it: your consent (Art. 6(1)(a) GDPR), which you can withdraw at any time.<br>• If you become a client: performance of the contract and accounting obligations (Art. 6(1)(b) and 6(1)(c) GDPR).' },
      { h: 'Retention periods', p: '• Exchanges with prospects: 3 years from the last contact.<br>• Contract documents and accounting records: 10 years, as required by French commercial law.<br>• Google Analytics statistics: 14 months; analytics cookies expire after 13 months at most.<br>• Your cookie choice: 6 months, after which you are asked again.<br>• Host technical logs: for a limited period, according to Netlify’s policy.' },
      { h: 'Recipients and transfers', p: `Your data is intended for Peleweb only and is never sold or shared. It may be processed by the following providers:<br>• the website host, ${netlify};<br>• Google Ireland Limited (Gordon House, Barrow Street, Dublin 4, Ireland), for Google Analytics audience measurement, if you accepted it;<br>• the email provider for contact@peleweb.com (OVHcloud, France);<br>• WhatsApp Ireland Limited, if you contact me with the WhatsApp button (the link opens the WhatsApp app, which has its own privacy policy).<br>Netlify, Google LLC and Meta Platforms (WhatsApp’s parent company) are based in the United States: these transfers are covered by the EU–US Data Privacy Framework, in which these companies participate.` },
      { h: 'Cookies and trackers', p: 'On your first visit, a banner lets you <strong>accept or refuse</strong> audience measurement, one as easily as the other. Without your consent, no Google Analytics cookie is set and no data is sent to Google.<br>The trackers used are:<br>• <strong>_ga</strong> and <strong>_ga_&lt;id&gt;</strong> (Google Analytics, 13 months maximum): tell visitors and visits apart, only after your consent;<br>• <strong>pw-consent</strong> (local storage, 6 months): remember your cookie choice;<br>• <strong>pw-theme</strong> (local storage): remember your light or dark theme choice.<br>Fonts are hosted on the website itself and involve no third party.<br>You can change your choice at any time with the <strong>“Manage cookies”</strong> link at the bottom of every page, or delete cookies in your browser settings.' },
      { h: 'Your rights', p: `You have the right to access, rectify, erase, restrict, object to and port your data, and to withdraw your consent at any time. To exercise these rights, email ${mail}. You will receive an answer within one month.<br>If you believe your rights have not been respected, you can lodge a complaint with the French data protection authority (CNIL): <a href="https://www.cnil.fr" rel="noopener">cnil.fr</a>.` },
    ],
    es: [
      { h: 'Responsable del tratamiento', p: `Umberto Persichini (Peleweb, auto-entreprise francesa), ${address}. Contacto: ${mail}` },
      { h: 'Datos recogidos', p: 'El sitio no tiene formularios ni cuentas de usuario. Los datos tratados son:<br>• <strong>los mensajes que envía por email o por WhatsApp</strong> (nombre, número de teléfono para WhatsApp, dirección de email, contenido del mensaje y cualquier información que decida compartir);<br>• <strong>los datos técnicos de conexión</strong> (dirección IP, tipo de navegador, páginas solicitadas), registrados automáticamente por el alojamiento para mostrar y proteger el sitio;<br>• <strong>las estadísticas de visita</strong>, <em>solo si usted las acepta</em>: páginas vistas, duración de la visita, procedencia (buscador, enlace…), tipo de dispositivo y navegador, ciudad o país aproximado. Estos datos los recoge Google Analytics mediante cookies.' },
      { h: 'Finalidades y bases jurídicas', p: '• Responder a sus solicitudes y preparar un presupuesto: medidas precontractuales a petición suya (art. 6.1.b del RGPD).<br>• Garantizar el funcionamiento y la seguridad del sitio: interés legítimo (art. 6.1.f del RGPD).<br>• Medir la audiencia del sitio para mejorarlo: su consentimiento (art. 6.1.a del RGPD), que puede retirar en cualquier momento.<br>• Si se convierte en cliente: ejecución del contrato y obligaciones contables (art. 6.1.b y 6.1.c del RGPD).' },
      { h: 'Plazos de conservación', p: '• Intercambios con clientes potenciales: 3 años desde el último contacto.<br>• Documentos contractuales y contables: 10 años, conforme al Código de Comercio francés.<br>• Estadísticas de Google Analytics: 14 meses; las cookies de medición caducan como máximo a los 13 meses.<br>• Su elección sobre las cookies: 6 meses; después se le vuelve a preguntar.<br>• Registros técnicos del alojamiento: durante un tiempo limitado, según la política de Netlify.' },
      { h: 'Destinatarios y transferencias', p: `Sus datos están destinados únicamente a Peleweb y nunca se venden ni se ceden. Pueden ser tratados por los siguientes proveedores:<br>• el alojamiento del sitio, ${netlify};<br>• Google Ireland Limited (Gordon House, Barrow Street, Dublín 4, Irlanda), para la medición de audiencia de Google Analytics, si la ha aceptado;<br>• el proveedor de correo de contact@peleweb.com (OVHcloud, Francia);<br>• WhatsApp Ireland Limited, si me contacta mediante el botón de WhatsApp (el enlace abre la aplicación WhatsApp, sujeta a su propia política de privacidad).<br>Netlify, Google LLC y Meta Platforms (matriz de WhatsApp) están ubicados en Estados Unidos: estas transferencias están amparadas por el Marco de Privacidad de Datos UE–EE. UU., al que estas empresas están adheridas.` },
      { h: 'Cookies y rastreadores', p: 'En su primera visita, un banner le permite <strong>aceptar o rechazar</strong> la medición de audiencia, con la misma facilidad. Sin su consentimiento, no se instala ninguna cookie de Google Analytics ni se envía ningún dato a Google.<br>Los rastreadores utilizados son:<br>• <strong>_ga</strong> y <strong>_ga_&lt;id&gt;</strong> (Google Analytics, 13 meses como máximo): distinguir visitantes y visitas, solo tras su consentimiento;<br>• <strong>pw-consent</strong> (almacenamiento local, 6 meses): recordar su elección sobre las cookies;<br>• <strong>pw-theme</strong> (almacenamiento local): recordar su elección de tema claro u oscuro.<br>Las fuentes tipográficas están alojadas en el propio sitio y no implican a ningún tercero.<br>Puede cambiar su elección en cualquier momento con el enlace <strong>«Gestionar cookies»</strong> al pie de cada página, o borrar las cookies desde los ajustes de su navegador.' },
      { h: 'Sus derechos', p: `Tiene derecho de acceso, rectificación, supresión, limitación, oposición y portabilidad de sus datos, así como a retirar su consentimiento en cualquier momento. Para ejercerlos, escriba a ${mail}. Recibirá una respuesta en el plazo de un mes.<br>Si considera que sus derechos no se han respetado, puede presentar una reclamación ante la autoridad francesa de protección de datos (CNIL): <a href="https://www.cnil.fr" rel="noopener">cnil.fr</a>.` },
    ],
  },
};

const title = page === 'legal' ? t.ui.legalTitle : t.ui.privacyTitle;
const updatedLabel = { fr: 'Dernière mise à jour', en: 'Last updated', es: 'Última actualización' }[lang];
---
<Base lang={lang} title={`${title} — Peleweb`} description={t.meta.description} locale={t.meta.locale} paths={paths}>
  <Header t={t} lang={lang} paths={paths} />
  <main id="contenu" class="legal">
    <div class="wrap">
      <h1>{title}</h1>
      <p class="legal-date mono">{updatedLabel}{lang === 'fr' ? ' : ' : ': '}{UPDATED[lang]}</p>
      {content[page][lang].map((s) => (
        <section>
          <h2>{s.h}</h2>
          <p set:html={s.p} />
        </section>
      ))}
    </div>
  </main>
  <Footer t={t} lang={lang} paths={paths} />
</Base>
