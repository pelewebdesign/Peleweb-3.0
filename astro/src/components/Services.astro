---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
import Builder from './Builder.astro';
const { t } = Astro.props;
const s = t.svc;

const icons = {
  refresh: '<path d="M21 12a9 9 0 0 1-15.5 6.2L3 16"></path><path d="M3 12a9 9 0 0 1 15.5-6.2L21 8"></path><path d="M21 3v5h-5"></path><path d="M3 21v-5h5"></path>',
  cart: '<circle cx="9" cy="20" r="1.5"></circle><circle cx="18" cy="20" r="1.5"></circle><path d="M2 3h3l2.7 12.4a2 2 0 0 0 2 1.6h7.7a2 2 0 0 0 2-1.5L21 8H6"></path>',
  search: '<circle cx="11" cy="11" r="7"></circle><path d="m20 20-3.5-3.5"></path>',
  shield: '<path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"></path><path d="m9 12 2 2 4-4"></path>',
  server: '<rect x="3" y="3" width="18" height="7" rx="2"></rect><rect x="3" y="14" width="18" height="7" rx="2"></rect><path d="M7 6.5h.01M7 17.5h.01"></path>',
};
const cards = [
  { ...s.s2, icon: icons.refresh, n: '02' },
  { ...s.s3, icon: icons.cart, n: '03' },
  { ...s.s4, icon: icons.search, n: '04' },
  { ...s.s5, icon: icons.shield, n: '05' },
  { ...s.s6, icon: icons.server, n: '06' },
];
---
<section class="sec" id="services" aria-labelledby="services-title">
  <div class="wrap">
    <div class="head rv">
      <div>
        <span class="lbl mono">{s.lbl}</span>
        <h2 class="disp h2" id="services-title">{s.h2a} <span class="gt">{s.h2b}</span></h2>
      </div>
      <p class="lead">{s.lead}</p>
    </div>

    <div class="bento">
      <article class="svc svc-feat pastel force-ink rv">
        <Grain soft />
        <div class="svc-top">
          <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 20h9"></path><path d="M16.5 3.5a2.1 2.1 0 0 1 3 3L7 19l-4 1 1-4Z"></path></svg></span>
          <span class="mono">01 / 06</span>
        </div>
        <Builder t={t} />
        <div class="bottom">
          <div>
            <h3 class="disp">{s.s1.title}</h3>
            <p>{s.s1.text}</p>
          </div>
          <a class="go-link" href={t.mailto}>{s.s1.link}<Arrow /></a>
        </div>
      </article>

      {cards.map((c) => (
        <article class="svc rv">
          <div class="svc-top">
            <span class="ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={c.icon}></svg></span>
            <span class="mono">{c.n} / 06</span>
          </div>
          <div><h3 class="disp">{c.title}</h3><p>{c.text}</p></div>
        </article>
      ))}
    </div>
  </div>
</section>
