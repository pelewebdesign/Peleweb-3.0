---
import Grain from './Grain.astro';
const { t, projects } = Astro.props;
const p = t.proj;
// Dégradé de secours, utilisé seulement si un projet n'a pas encore de capture.
const tints = [
  '--g2: var(--c4); --g3: var(--c3)',
  '--g2: var(--c2); --g3: var(--c4)',
  '--g2: var(--c3); --g3: var(--c2)',
];
---
<section class="sec" id="projets" aria-labelledby="projets-title">
  <div class="wrap">
    <div class="p-head rv">
      <div>
        <span class="lbl mono" style="display: block; margin-bottom: 24px; color: var(--muted)">{p.lbl}</span>
        <h2 class="disp h2" id="projets-title">{p.h2a} <span class="gt">{p.h2b}</span></h2>
      </div>
    </div>
  </div>

  <div class="plist">
    {projects.map((item, i) => (
      <a class="prow" href={item.url} target="_blank" rel="noopener">
        <div class="pmeta mono"><span class="n">{item.n}</span><span class="t">{item.type}</span><span class="d">{item.domain}</span></div>
        <span class="go" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"></path></svg></span>
        <h3 class="disp pname"><span>{item.name}</span></h3>
        <p class="sr">{item.desc}</p>
        <div class="pprev">
          <div class="fp" style={tints[i % tints.length]}>
            <div class="bar" aria-hidden="true"><i></i><i></i><i></i><span>{item.domain}</span></div>
            {item.image ? (
              <img
                class="shot"
                src={item.image}
                srcset={`${item.imageSmall} 720w, ${item.image} 1440w`}
                sizes="(max-width: 1100px) 92vw, 420px"
                width="1440"
                height="900"
                loading="lazy"
                decoding="async"
                alt={`${t.ui.shotAlt} ${item.name}`}
              />
            ) : (
              <div class="art" aria-hidden="true"><Grain /></div>
            )}
          </div>
        </div>
      </a>
    ))}
  </div>
</section>
