---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
const { t } = Astro.props;
const c = t.cta;
---
<section class="cta" id="contact" aria-labelledby="cta-title">
  <div class="cta-box force-dark">
    <div class="blob b1" aria-hidden="true"></div>
    <div class="blob b2" aria-hidden="true"></div>
    <div class="blob b3" aria-hidden="true"></div>
    <Grain />
    <div class="inner">
      <span class="lbl mono">{c.lbl}</span>
      <h2 class="disp" id="cta-title">{c.l1}<br>{c.l2}</h2>
      <p class="lead">{c.lead}</p>
      <div class="cta-btns">
        <a class="btn btn-solid" href={t.mailto}>{c.btn}<span class="ar"><Arrow /></span></a>
        <a class="btn btn-ghost" href={t.mailto}>contact@peleweb.com</a>
      </div>
    </div>
  </div>
</section>
