---
/** Animation « page builder » de la carte Création (CSS uniquement, en boucle de 12 s). */
import Grain from './Grain.astro';
const { t } = Astro.props;
const b = t.bld;
---
<div class="bld" aria-hidden="true">
  <div class="bld-bar"><i></i><i></i><i></i><span class="bw-url">{t.svc.url}</span><span class="bld-pub">{b.pub}</span></div>
  <div class="bld-side">
    <span class="bld-tool"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M5 6h14M12 6v13"></path></svg>{b.t1}</span>
    <span class="bld-tool"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="5" width="18" height="14" rx="2"></rect><path d="m3 16 5-5 4 4 3-3 6 6"></path></svg>{b.t2}</span>
    <span class="bld-tool"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><rect x="3" y="8" width="18" height="8" rx="4"></rect></svg>{b.t3}</span>
    <span class="bld-tool"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="7" height="16" rx="1.5"></rect><rect x="14" y="4" width="7" height="16" rx="1.5"></rect></svg>{b.t4}</span>
  </div>
  <div class="bld-canvas">
    <div class="bc-hero"><Grain /><span class="bc-h1"></span><span class="bc-h2"></span><span class="bc-btn"></span></div>
    <span class="bc-sel"><i></i><i></i><i></i><i></i></span>
    <div class="bc-cards"><span class="bc-card k1"></span><span class="bc-card k2"></span><span class="bc-card k3"></span></div>
    <div class="bc-lines"><i></i><i></i></div>
  </div>
  <span class="bld-sw"><i></i><i></i><i></i></span>
  <span class="bld-ghost"></span>
  <span class="bld-toast"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"></path></svg>{b.done}</span>
  <span class="bld-cursor"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 2.5 20 10l-7 2.2L10.5 19Z"></path></svg></span>
</div>
