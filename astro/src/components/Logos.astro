---
/** Bandeau des logos clients : toujours sur fond blanc, dans les deux thèmes. */
const { t, clients } = Astro.props;
---
{clients.length > 0 && (
  <section class="logos" aria-label={t.logos.aria}>
    <div class="lg-mq">
      <div class="lg-track">
        {[0, 1].map((copy) => (
          <ul class="lg-seq" aria-hidden={copy === 1 ? 'true' : undefined}>
            {clients.map((c) => (
              <li class="lg-slot">
                {c.logo
                  ? <img src={c.logo} alt={copy === 0 ? c.name : ''} loading="lazy" decoding="async" width="150" height="64" />
                  : c.name}
              </li>
            ))}
          </ul>
        ))}
      </div>
    </div>
  </section>
)}
