---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
const { t, pricing } = Astro.props;
const p = t.tar;
---
<section class="sec tarifs" id="tarifs" aria-labelledby="tarifs-title">
  <div class="blob b1" aria-hidden="true"></div>
  <div class="wrap">
    <div class="head rv">
      <div>
        <span class="lbl mono">{p.lbl}</span>
        <h2 class="disp h2" id="tarifs-title">{p.h2a}<span class="gt">{p.h2b}</span>{p.h2c}</h2>
      </div>
      <p class="lead">{p.lead}</p>
    </div>

    <div class="prices">
      {pricing.map((f) => (
        <article class:list={['price', 'rv', { 'price-feat pastel force-ink': f.featured }]}>
          {f.featured && <><Grain soft /><span class="ribbon">{p.badge}</span></>}
          <h3 class="disp">{f.name}</h3>
          <p class="desc">{f.desc}</p>
          <p class="from mono">{p.from}</p>
          <p class="amount"><b>{f.price}</b><span>{p.tax}</span></p>
          <ul>
            {f.items.map((item) => (
              <li><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"></path></svg>{item}</li>
            ))}
          </ul>
          <a class="btn btn-solid" href={t.mailto}>{p.btn}<span class="ar"><Arrow /></span></a>
        </article>
      ))}
    </div>

    <div class="maint rv">
      <div>
        <h3 class="disp">{p.mTitle}</h3>
        <p>{p.mText}</p>
      </div>
      <div class="maint-r">
        <b>{p.mPrice} <small>{p.mSuffix}</small></b>
        <a class="btn btn-ghost" href={t.mailto}>{p.mBtn}</a>
      </div>
    </div>
    <p class="note">{p.note} <a href={t.mailto}>{p.noteLink}</a>.</p>
  </div>
</section>
