---
import Arrow from './Arrow.astro';
import LangSwitch from './LangSwitch.astro';
const { t, lang, paths } = Astro.props;
// Liens vers les sections de l'accueil : « /#services » fonctionne aussi depuis les pages légales.
const home = t.ui.home;
const links = [
  [`${home}#services`, t.nav.services],
  [`${home}#projets`, t.nav.projets],
  [`${home}#tarifs`, t.nav.tarifs],
  [`${home}#faq`, 'FAQ'],
];
---
<a class="skip" href="#contenu">{t.ui.skip}</a>
<div class="progress" aria-hidden="true"></div>

<header class="hd">
  <a class="logo" href={t.ui.home} aria-label={t.ui.logoAria}><span class="logo-orb" aria-hidden="true"></span>peleweb</a>
  <nav class="hd-nav" aria-label={t.navAria}>
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <div class="hd-r">
    <button class="iconbtn" type="button" data-theme-toggle data-label-dark={t.ui.toLight} data-label-light={t.ui.toDark} aria-label={t.ui.toLight}>
      <svg class="ic-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"></circle><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path></svg>
      <svg class="ic-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8Z"></path></svg>
    </button>
    <LangSwitch t={t} lang={lang} paths={paths} />
    <a class="btn btn-solid btn-sm hd-cta" href={t.mailto}>{t.nav.cta}</a>
    <button class="burger" type="button" aria-expanded="false" aria-controls="mnav" data-menu-toggle data-label-open={t.ui.menuOpen} data-label-close={t.ui.menuClose} aria-label={t.ui.menuOpen}><span></span><span></span></button>
  </div>
</header>

<nav class="mnav" id="mnav" aria-label={t.mnavAria}>
  {links.map(([href, label]) => <a href={href}>{label}</a>)}
  <LangSwitch t={t} lang={lang} paths={paths} inline />
  <a class="btn btn-solid" href={t.mailto}>{t.nav.cta}<span class="ar"><Arrow /></span></a>
</nav>
