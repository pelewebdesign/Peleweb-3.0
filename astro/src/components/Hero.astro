---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
import PortraitSvg from './PortraitSvg.astro';
const { t } = Astro.props;
const h = t.hero;
const who = h.who.split(' — ');
---
<section class="hero" aria-labelledby="hero-title">
  <div class="blob b1" aria-hidden="true"></div>
  <div class="blob b2" aria-hidden="true"></div>
  <div class="blob b3" aria-hidden="true"></div>
  <div class="blob b4" aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>
  <Grain />
  <div class="wrap">
    <div class="hero-top">
      <span class="avail mono"><span class="dot" aria-hidden="true"></span><span class="av-who"><span>{who[0]}</span>{who[1] && <><span class="av-sep"> — </span><span>{who[1]}</span></>}</span></span>
    </div>

    <div class="hero-main">
      <div class="hero-copy">
        <h1 class="disp h1" id="hero-title">
          <span class="ln"><span style="animation-delay: .05s">{h.l1}</span></span>
          <span class="ln"><span style="animation-delay: .18s"><span class="outline">{h.l2}</span><span class="pill-orb" aria-hidden="true"><svg class="sp" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5c.7 6.2 4.3 9.8 10.5 10.5-6.2.7-9.8 4.3-10.5 10.5-.7-6.2-4.3-9.8-10.5-10.5C7.7 11.3 11.3 7.7 12 1.5Z"></path></svg></span></span></span>
          <span class="ln"><span style="animation-delay: .31s"><span class="gt">{h.l3}</span></span></span>
        </h1>

        <p class="disp rotline">{h.rotPre}
          <span class="rot"><span class="rot-in"><span>{h.r1}</span><span>{h.r2}</span><span>{h.r3}</span><span>{h.r4}</span><span aria-hidden="true">{h.r1}</span></span></span>
        </p>

        <div class="hero-row">
          <div class="hero-left">
            <p class="hero-text">{h.text}</p>
            <div class="stats">
              <div class="stat"><b>{h.n1}</b><span>{h.s1}</span></div>
              <div class="stat"><b>{h.n2}</b><span>{h.s2}</span></div>
              <div class="stat"><b>{h.n3}</b><span>{h.s3}</span></div>
            </div>
          </div>
          <div class="hero-ctas">
            <a class="btn btn-solid" href={t.mailto}>{h.cta1}<span class="ar"><Arrow /></span></a>
            <a class="btn btn-ghost" href="#projets">{h.cta2}</a>
          </div>
        </div>
      </div>

      <div class="hero-vis">
        <div class="pt" data-tilt>
          <figure class="pt-card" role="img" aria-label={h.portrait}>
            <PortraitSvg />
          </figure>
          <span class="pt-hello disp" aria-hidden="true">{h.hello}</span>
          <span class="pt-hint mono" aria-hidden="true"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M5 3l14 7.5-6.2 1.6L10 18z"/></svg>{h.hover}</span>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  // Inclinaison 3D de la carte portrait selon la position de la souris.
  const pt = document.querySelector<HTMLElement>('[data-tilt]');
  if (pt && matchMedia('(hover: hover) and (prefers-reduced-motion: no-preference)').matches) {
    let raf = 0;
    const set = (x: number, y: number) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => { pt.style.setProperty('--mx', x.toFixed(3)); pt.style.setProperty('--my', y.toFixed(3)); });
    };
    window.addEventListener('pointermove', (e) => {
      const r = pt.getBoundingClientRect();
      const x = (e.clientX - (r.left + r.width / 2)) / innerWidth;
      const y = (e.clientY - (r.top + r.height / 2)) / innerHeight;
      set(Math.max(-1, Math.min(1, x * 2)), Math.max(-1, Math.min(1, y * 2)));
    }, { passive: true });
    document.documentElement.addEventListener('pointerleave', () => set(0, 0));
  }
</script>
