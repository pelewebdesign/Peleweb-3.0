---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
const { t } = Astro.props;
const h = t.hero;
---
<section class="hero" aria-labelledby="hero-title">
  <div class="blob b1" aria-hidden="true"></div>
  <div class="blob b2" aria-hidden="true"></div>
  <div class="blob b3" aria-hidden="true"></div>
  <div class="blob b4" aria-hidden="true"></div>
  <div class="veil" aria-hidden="true"></div>
  <Grain />
  <div class="wrap">
    <div class="hero-top">
      <span class="avail mono"><span class="dot" aria-hidden="true"></span>{h.who}</span>
      <span class="mono">{h.langs}</span>
    </div>

    <h1 class="disp h1" id="hero-title">
      <span class="ln"><span style="animation-delay: .05s">{h.l1}</span></span>
      <span class="ln"><span style="animation-delay: .18s"><span class="outline">{h.l2}</span><span class="pill-orb" aria-hidden="true"><svg class="sp" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5c.7 6.2 4.3 9.8 10.5 10.5-6.2.7-9.8 4.3-10.5 10.5-.7-6.2-4.3-9.8-10.5-10.5C7.7 11.3 11.3 7.7 12 1.5Z"></path></svg></span></span></span>
      <span class="ln"><span style="animation-delay: .31s"><span class="gt">{h.l3}</span></span></span>
    </h1>

    <p class="disp rotline">{h.rotPre}
      <span class="rot"><span class="rot-in"><span>{h.r1}</span><span>{h.r2}</span><span>{h.r3}</span><span>{h.r4}</span><span aria-hidden="true">{h.r1}</span></span></span>
    </p>

    <div class="hero-grid">
      <div>
        <p class="hero-text">{h.text}</p>
        <div class="hero-ctas">
          <a class="btn btn-solid" href={t.mailto}>{h.cta1}<span class="ar"><Arrow /></span></a>
          <a class="btn btn-ghost" href="#projets">{h.cta2}</a>
        </div>
      </div>
      <div class="hero-vis" aria-hidden="true">
        <div class="orb"><Grain /></div>
        <div class="badge">
          <svg class="ring" viewBox="0 0 200 200"><defs><path id="heroRing" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0"></path></defs><text font-family="Geist Mono, monospace" font-size="12" letter-spacing="2.6" fill="currentColor"><textPath href="#heroRing">{h.ring}</textPath></text></svg>
          <span class="core"><Arrow /></span>
        </div>
      </div>
    </div>

    <div class="stats">
      <div class="stat"><b>30+</b><span>{h.s1}</span></div>
      <div class="stat"><b>6</b><span>{h.s2}</span></div>
      <div class="stat"><b>3</b><span>{h.s3}</span></div>
    </div>
  </div>
</section>
