---
import Grain from './Grain.astro';
const { t } = Astro.props;
const a = t.app;
---
<section class="sec" id="approche" aria-labelledby="approche-title" style="padding-top: 20px">
  <div class="wrap">
    <div class="bio rv">
      <span class="av" aria-hidden="true">UP</span>
      <div>
        <span class="lbl mono">{a.lbl}</span>
        <h2 class="bio-t" id="approche-title">Umberto Persichini<br><span>{a.role}</span></h2>
      </div>
    </div>

    <div class="trio">
      <article class="tcard rv">
        <div class="tvis" aria-hidden="true">
          <div class="dots"></div>
          <div class="glow"></div>
          <span class="marker"></span>
          <div class="tabs-wrap"><div class="tabs"><span class="on">{a.tab1}</span><span>{a.tab2}</span><span>{a.tab3}</span><span>{a.tab4}</span><span>{a.tab5}</span></div></div>
          <div class="tile3d"><Grain /><svg class="sp" viewBox="0 0 24 24" fill="currentColor"><path d="M12 1.5c.7 6.2 4.3 9.8 10.5 10.5-6.2.7-9.8 4.3-10.5 10.5-.7-6.2-4.3-9.8-10.5-10.5C7.7 11.3 11.3 7.7 12 1.5Z"></path></svg></div>
          <Grain />
        </div>
        <h3 class="ttext">{a.c1a} <span>{a.c1b}</span></h3>
      </article>

      <article class="tcard rv">
        <div class="tvis" aria-hidden="true">
          <div class="dots"></div>
          <div class="glow" style="background: radial-gradient(circle, var(--c2), transparent 62%)"></div>
          <div class="toggle"><span class="knob"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M13 2 4 14h7l-1 8 9-12h-7Z"></path></svg></span></div>
          <div class="tg-l"><span class="chip">{a.chip1}</span><span class="chip">{a.chip2}</span><span class="chip">SEO</span></div>
          <Grain />
        </div>
        <h3 class="ttext">{a.c2a} <span>{a.c2b}</span></h3>
      </article>

      <article class="tcard rv">
        <div class="tvis" aria-hidden="true">
          <div class="dots"></div>
          <div class="glow" style="background: radial-gradient(circle, var(--c3), transparent 62%)"></div>
          <span class="tag3" style="left: 40px; top: 56px; background: var(--lime); color: var(--ink); --r: -6deg">{a.tag1}</span>
          <span class="tag3 bordered" style="right: 36px; top: 112px; background: var(--surface); color: var(--text); --r: 5deg; animation-delay: -2s">{a.tag2}</span>
          <span class="tag3" style="left: 56px; top: 184px; background: var(--c1); color: var(--white); --r: 4deg; animation-delay: -4s">{a.tag3}</span>
          <span class="tag3" style="right: 48px; bottom: 44px; background: var(--p3); color: var(--ink); --r: -4deg; animation-delay: -1s">Maintenance</span>
          <span class="cur"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M4 2.5 20 10l-7 2.2L10.5 19Z"></path></svg><span>Umberto</span></span>
          <Grain />
        </div>
        <h3 class="ttext">{a.c3a} <span>{a.c3b}</span></h3>
      </article>
    </div>
  </div>
</section>
