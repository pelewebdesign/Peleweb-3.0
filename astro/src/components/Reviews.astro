---
import Arrow from './Arrow.astro';
import Grain from './Grain.astro';
const { t, reviews, lang } = Astro.props;
const r = t.rev;
const quotes = { fr: ['« ', ' »'], en: ['“', '”'], es: ['«', '»'] }[lang as 'fr' | 'en' | 'es'];
const star = '<path d="m12 2 3.1 6.3 6.9 1-5 4.9 1.2 6.8L12 17.8 5.8 21l1.2-6.8-5-4.9 6.9-1Z"></path>';
---
<section class="sec" id="avis" aria-labelledby="avis-title" style="padding-top: 60px">
  <div class="wrap">
    <div class="head rv" style="margin-bottom: 48px">
      <div>
        <span class="lbl mono">{r.lbl}</span>
        <h2 class="disp h2" id="avis-title">{r.h2a}<span class="gt">{r.h2b}</span>{r.h2c}</h2>
      </div>
      <div class="rev-side">
        <p class="mono">{r.hint}</p>
        <a class="btn btn-ghost" href={r.moreUrl} target="_blank" rel="noopener">{r.more}<span class="ar ar-ghost"><Arrow /></span></a>
      </div>
    </div>
  </div>
  <div class="track" role="region" aria-label={r.aria} tabindex="0">
    {reviews.map((q) => (
      <figure class:list={['qc', { 'pastel force-ink': q.featured }]}>
        {q.featured && <Grain soft />}
        <p class="stars">
          <span class="sr">{r.stars}</span>
          {[1, 2, 3, 4, 5].map(() => <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" set:html={star}></svg>)}
        </p>
        <blockquote>{quotes[0]}{q.quote}{quotes[1]}</blockquote>
        <figcaption class="who-q">
          {q.logo
            ? <span class="q-logo"><img src={q.logo} alt={q.company} width="96" height="48" loading="lazy" decoding="async" /></span>
            : <span class="av" aria-hidden="true">{q.initials || '?'}</span>}
          <span><strong>{q.name || t.ui.namePh}</strong><span>{q.company || t.ui.companyPh}</span></span>
        </figcaption>
      </figure>
    ))}
  </div>
</section>
