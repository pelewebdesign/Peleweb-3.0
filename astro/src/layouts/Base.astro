---
/**
 * Gabarit commun : <head>, polices, thème sombre/clair, filtre de grain
 * et petits scripts (thème, menu mobile).
 */
import '../styles/global.css';
import type { Lang } from '../lib/content';

interface Props {
  lang: Lang;
  title: string;
  description: string;
  locale: string;
  /** Chemin de cette page en français et en anglais (pour les balises hreflang). */
  paths: { fr: string; en: string };
}

const { lang, title, description, locale, paths } = Astro.props;
const site = Astro.site ?? new URL('https://peleweb.com');
const canonical = new URL(paths[lang], site).href;
---
<!doctype html>
<html lang={lang} data-theme="dark">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
<meta name="description" content={description}>
<link rel="canonical" href={canonical}>
<link rel="alternate" hreflang="fr" href={new URL(paths.fr, site).href}>
<link rel="alternate" hreflang="en" href={new URL(paths.en, site).href}>
<link rel="alternate" hreflang="x-default" href={new URL(paths.fr, site).href}>
<meta property="og:type" content="website">
<meta property="og:title" content={title}>
<meta property="og:description" content={description}>
<meta property="og:url" content={canonical}>
<meta property="og:locale" content={locale}>
<meta name="theme-color" content="#0D0A1C">
<link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,200..800&family=Geist:wght@300..700&family=Geist+Mono:wght@400;500&display=swap">
<script is:inline>
  // Applique le thème avant l'affichage pour éviter un flash :
  // choix mémorisé, sinon préférence du système, sinon sombre.
  (function () {
    var theme = null;
    try { theme = localStorage.getItem('pw-theme'); } catch (e) {}
    if (theme !== 'light' && theme !== 'dark') {
      theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
    }
    document.documentElement.setAttribute('data-theme', theme);
  })();
</script>
</head>
<body>
<svg width="0" height="0" style="position: absolute" aria-hidden="true" focusable="false">
  <filter id="pwGrain" x="0" y="0" width="100%" height="100%">
    <feTurbulence type="fractalNoise" baseFrequency="0.85" numOctaves="3" stitchTiles="stitch"></feTurbulence>
    <feColorMatrix type="saturate" values="0"></feColorMatrix>
  </filter>
</svg>
<slot />

<script>
  const root = document.documentElement;

  // ---------- Thème sombre / clair ----------
  const themeButtons = document.querySelectorAll<HTMLButtonElement>('[data-theme-toggle]');
  const syncThemeLabels = () => {
    const isDark = root.getAttribute('data-theme') !== 'light';
    themeButtons.forEach((btn) => {
      btn.setAttribute('aria-label', (isDark ? btn.dataset.labelDark : btn.dataset.labelLight) ?? '');
    });
  };
  themeButtons.forEach((btn) =>
    btn.addEventListener('click', () => {
      const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
      root.setAttribute('data-theme', next);
      try { localStorage.setItem('pw-theme', next); } catch (e) {}
      syncThemeLabels();
    }),
  );
  syncThemeLabels();

  // ---------- Menu mobile ----------
  const burger = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const menu = document.getElementById('mnav');
  const setMenu = (open: boolean) => {
    if (!burger || !menu) return;
    menu.classList.toggle('is-open', open);
    burger.classList.toggle('is-open', open);
    burger.setAttribute('aria-expanded', String(open));
    burger.setAttribute('aria-label', (open ? burger.dataset.labelClose : burger.dataset.labelOpen) ?? '');
  };
  burger?.addEventListener('click', () => setMenu(!menu?.classList.contains('is-open')));
  menu?.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setMenu(false)));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape') setMenu(false); });
</script>
</body>
</html>
